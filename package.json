{
  "name": "p2l-qa-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "QA automatizado Playwright para el panel empresa P2L (producción).",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:sim-lab": "playwright test tests/uber-like-simulation-qa.spec.js --headed --project=chrome --workers=1 --reporter=list",
    "test:qa:m1": "playwright test tests/qa-lab/momentum-1.accepted.spec.js --project=chrome --workers=1 --reporter=list,html",
    "test:qa:stage": "playwright test tests/qa-lab/momentum-1.accepted.spec.js --project=chrome --workers=1 --reporter=list,html",
    "report": "playwright show-report",
    "storage:save": "node scripts/saveStorageManual.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "dotenv": "^16.4.5"
  }
}
